// Default settings for a device-provided AIDL HAL build; generated AIDL/crypto dependencies are external.
cc_defaults {
    name: "green2_pasn_android_defaults",
    vendor: true,
    header_libs: ["green2_whc_public_headers"],
    cflags: ["-DCONFIG_SAE", "-DCONFIG_PASN", "-DCONFIG_NAN", "-D_GNU_SOURCE"],
}
