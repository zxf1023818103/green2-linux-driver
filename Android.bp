// Soong file exports; kernel modules themselves are compiled by Kbuild/Kleaf.
filegroup {
    name: "green2_whc_kernel_sources",
    visibility: ["//visibility:public"],
    srcs: ["driver/Kbuild", "driver/Makefile", "driver/configs/*_defconfig", "driver/**/*.c", "driver/**/*.h", "driver/**/Kbuild", "shared/include/*.h"],
}
cc_library_headers {
    name: "green2_whc_public_headers",
    vendor_available: true,
    visibility: ["//visibility:public"],
    export_include_dirs: ["shared/include", "cli_tool"],
}
filegroup {
    name: "green2_pasn_core_sources",
    visibility: ["//visibility:public"],
    srcs: ["cli_tool/pasn_engine.c", "shared/src/protocol_common.c"],
}
